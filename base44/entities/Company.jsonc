{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "STARTER",
        "GROWTH",
        "ENTERPRISE"
      ],
      "default": "STARTER"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "MONTHLY",
        "ANNUAL"
      ],
      "default": "MONTHLY"
    },
    "max_employees": {
      "type": "number",
      "default": 15
    },
    "seats_used": {
      "type": "number",
      "default": 0
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "TRIAL",
        "ACTIVE",
        "PAST_DUE",
        "CANCELLED"
      ],
      "default": "TRIAL"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "total_saved": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        },
        {
          "id": "{{user.data.company_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}