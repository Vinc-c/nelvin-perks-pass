{
  "name": "Offer",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "FOOD_DINING",
        "TRAVEL_HOLIDAYS",
        "HOTELS_HOSPITALITY",
        "FITNESS_SPORTS",
        "WELLNESS_MENTAL",
        "HEALTHCARE",
        "FINANCIAL_WELLNESS",
        "SHOPPING_RETAIL",
        "TECHNOLOGY",
        "FAMILY_PARENTING",
        "EDUCATION_LEARNING",
        "HOME_LIVING",
        "AUTOMOTIVE_MOBILITY",
        "BEAUTY_CARE",
        "ENTERTAINMENT"
      ],
      "default": "FOOD_DINING"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "PERCENTAGE",
        "FIXED",
        "CASHBACK",
        "BOGO"
      ],
      "default": "PERCENTAGE"
    },
    "discount_value": {
      "type": "number"
    },
    "deal_terms": {
      "type": "string"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "B2C",
        "B2B_ONLY",
        "ALL"
      ],
      "default": "ALL"
    },
    "cashback_rate": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "off_peak_hours": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "merchant_id",
    "title",
    "discount_type",
    "target_audience"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        },
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        },
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        },
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        }
      ]
    }
  }
}