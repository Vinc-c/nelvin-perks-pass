{
  "name": "InviteCode",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "target_email": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "EMPLOYEE",
        "HR_ADMIN"
      ],
      "default": "EMPLOYEE"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "USED",
        "EXPIRED",
        "REVOKED"
      ],
      "default": "PENDING"
    },
    "redeemed_by_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "code",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "HR_ADMIN"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "HR_ADMIN"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "HR_ADMIN"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "HR_ADMIN"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    }
  }
}